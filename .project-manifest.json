{
  "name": "Emberstripe",
  "description": "胶片灰度条带光学声轨数字化 HTTP 服务",
  "project_shape": "fullstack",
  "modules": [
    {
      "id": "capture",
      "path": "internal/capture/capture.go",
      "responsibility": "卷格式、条带灰度、位深、输入摘要和快照"
    },
    {
      "id": "gauge",
      "path": "internal/gauge/gauge.go",
      "responsibility": "计算和验证暗亮双声道标定"
    },
    {
      "id": "register",
      "path": "internal/register/register.go",
      "responsibility": "画格窗、原生时钟、源地址与覆盖范围"
    },
    {
      "id": "readout",
      "path": "internal/readout/readout.go",
      "responsibility": "灰度积分、削顶与立体声采样差分"
    },
    {
      "id": "wave",
      "path": "internal/wave/wave.go",
      "responsibility": "WAVE PCM 字节格式及头部检查"
    },
    {
      "id": "cue",
      "path": "internal/cue/cue.go",
      "responsibility": "听审报点解析、双声道报点音合成、发声段与报点表"
    },
    {
      "id": "view",
      "path": "internal/view/view.go",
      "responsibility": "画面灰度与取样诊断的同位置布局"
    },
    {
      "id": "parcel",
      "path": "internal/parcel/parcel.go",
      "responsibility": "冻结包、磁盘读写和声画格式核验"
    },
    {
      "id": "station",
      "path": "internal/station/station.go",
      "responsibility": "协调卷目录、取样与归档工作流"
    },
    {
      "id": "httpapi",
      "path": "internal/httpapi/httpapi.go",
      "responsibility": "请求参数、状态、响应编码和并发槽位"
    },
    {
      "id": "lightbench",
      "path": "internal/lightbench",
      "responsibility": "浏览器入口、画格投影、限流与画格时钟上的包络响应"
    },
    {
      "id": "bench-page",
      "path": "internal/lightbench/templates",
      "responsibility": "以扫描卷和可用标定构成可访问的中文浏览器工作台"
    },
    {
      "id": "bench-controls",
      "path": "internal/lightbench/assets/scripts",
      "responsibility": "编排浏览器工作窗、探针、双声道绘图、试听和冻结结果"
    }
  ],
  "workflows": [
    {
      "id": "intake",
      "name": "扫描卷登记",
      "entry": "GET /captures/{name}/header",
      "success": "来源摘要、原生位深和页号均可读",
      "failure": "未知卷 404",
      "verification": "python3 examples/walkthrough.py intake",
      "steps": [
        "启动加载扫描页与卷描述",
        "按已登记快照公开页清单和时钟"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "capture",
        "register"
      ]
    },
    {
      "id": "calibration",
      "name": "测量声槽标定",
      "entry": "GET /captures/{name}/calibration",
      "success": "按声道报告暗亮端点",
      "failure": "平场或参考缺失 400",
      "verification": "python3 examples/walkthrough.py calibration",
      "steps": [
        "依配置定位参考页及参考行",
        "在两个声槽独立积分并校验反差"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "capture",
        "gauge"
      ]
    },
    {
      "id": "register",
      "name": "查询画格和源行",
      "entry": "GET /captures/{name}/register",
      "success": "返回目标行、对应源行和可读状态",
      "failure": "非法行 400",
      "verification": "python3 examples/walkthrough.py register",
      "steps": [
        "把画格加局部行换为卷内行",
        "按正负偏移映射，再查源页是否可用"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "register",
        "capture"
      ]
    },
    {
      "id": "coverage",
      "name": "分解声音覆盖",
      "entry": "GET /captures/{name}/coverage",
      "success": "半开区间无重叠地划分画格窗",
      "failure": "空窗 400",
      "verification": "python3 examples/walkthrough.py coverage",
      "steps": [
        "验证请求窗长度",
        "跨声槽扫描页分段并合并同状态相邻段"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "register",
        "capture"
      ]
    },
    {
      "id": "trace",
      "name": "定位一个 PCM 样本",
      "entry": "GET /captures/{name}/trace",
      "success": "同一响应展示声槽行、灰度和削顶标记",
      "failure": "卷外画格 400",
      "verification": "python3 examples/walkthrough.py trace",
      "steps": [
        "校准声槽端点并查询源坐标",
        "对两个声槽积分并计算签名样本"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "gauge",
        "register",
        "capture",
        "readout"
      ]
    },
    {
      "id": "audition",
      "name": "按画格试听",
      "entry": "GET /captures/{name}/audition",
      "success": "返回两声道定长 WAV",
      "failure": "非法窗口 400",
      "verification": "python3 examples/walkthrough.py audition",
      "steps": [
        "计算可读区并生成缺口占位样本",
        "用原生每秒行数打包交错 PCM"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "gauge",
        "register",
        "readout",
        "wave",
        "capture"
      ]
    },
    {
      "id": "timing-track",
      "name": "导出听审计时带",
      "entry": "GET /captures/{name}/timing",
      "success": "返回与试听同窗长的双声道 WAV，报点在普通播放器可听，缺口保持静音",
      "failure": "报点越窗、重复或可听部分不足 5 毫秒为 400",
      "verification": "python3 examples/walkthrough.py timing-track",
      "steps": [
        "解析按画格行排序的 mark=frame:row 报点并校验窗口归属",
        "只在可读声槽行把报点短音加法混入双声道，缺口和窗尾不补材料",
        "逐报点记录发声段、可听样本数、补零段与原卷行换算关系"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "cue",
        "gauge",
        "register",
        "readout",
        "wave",
        "capture"
      ]
    },
    {
      "id": "timing-sheet",
      "name": "导出报点表",
      "entry": "GET /captures/{name}/timing-sheet",
      "success": "报点表给出实际时间、窗内采样帧、原卷画格行和补零段的可机读对应",
      "failure": "与计时带相同的参数校验失败为 400",
      "verification": "python3 examples/walkthrough.py timing-track",
      "steps": [
        "按同一份合成参数渲染计时带但仅返回 JSON 报点表",
        "按 origin_picture_row 与 sample_rate 说明导出时间到原卷行的找回公式"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "cue",
        "register",
        "capture"
      ]
    },
    {
      "id": "compare",
      "name": "比较标定试听差异",
      "entry": "GET /captures/{name}/compare",
      "success": "返回共同可读窗口的左右声道差分",
      "failure": "相同标定 400",
      "verification": "python3 examples/walkthrough.py compare",
      "steps": [
        "按同卷同窗分别量测与解释 PCM",
        "只比较可读样本并输出削顶与差分统计"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "gauge",
        "register",
        "readout",
        "capture"
      ]
    },
    {
      "id": "overlay",
      "name": "生成画格诊断图",
      "entry": "GET /captures/{name}/overlay",
      "success": "画面和声槽的逐行对照可查看",
      "failure": "无效画格 400",
      "verification": "python3 examples/walkthrough.py overlay",
      "steps": [
        "读取画格图区灰度",
        "在卷时钟上绘制两条声槽数据和缺失状态"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "gauge",
        "register",
        "view",
        "readout",
        "capture"
      ]
    },
    {
      "id": "release",
      "name": "冻结音频和画格索引",
      "entry": "POST /captures/{name}/release",
      "success": "可重放的 WAV 和画格索引同包发布",
      "failure": "坏标定 400",
      "verification": "python3 examples/walkthrough.py release",
      "steps": [
        "按选定标定生成 PCM 和覆盖",
        "绑定快照摘要、局部索引及 WAV，写完再公布"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "gauge",
        "register",
        "readout",
        "wave",
        "parcel"
      ]
    },
    {
      "id": "verify",
      "name": "复核已交付声画包",
      "entry": "GET /parcels/{id}/verify",
      "success": "验证同一媒体和时间索引",
      "failure": "存储字节损坏 409",
      "verification": "python3 examples/walkthrough.py verify",
      "steps": [
        "用标识读取冻结 ZIP",
        "核对声轨头、索引、覆盖分区及缺失静音"
      ],
      "module_ids": [
        "httpapi",
        "station",
        "parcel",
        "wave",
        "register"
      ]
    },
    {
      "id": "workbench",
      "name": "装载扫描卷与可用标定",
      "entry": "GET /lightbench/{reel}",
      "steps": [
        "列出启动时登记的卷",
        "按参考页和声道端点判定每个标定是否可用"
      ],
      "success": "显示当前卷、独立标定状态与工作入口",
      "failure": "未知卷显示 404，没有标定时关闭绘图入口",
      "verification": "python3 examples/walkthrough.py workbench",
      "module_ids": [
        "lightbench",
        "bench-page",
        "station",
        "capture",
        "gauge"
      ]
    },
    {
      "id": "window-inspection",
      "name": "查看双声道范围和画格覆盖",
      "entry": "GET /lightbench/{reel}/window",
      "steps": [
        "验证零基半开窗口与光学标定",
        "按画格行输出声槽包络及扫描页状态",
        "在浏览器同步条带、波形与画格探针"
      ],
      "success": "每条覆盖区间和左右极值归属到同一画格时钟",
      "failure": "无效区间或不可用标定保留前次浏览器结果",
      "verification": "python3 examples/walkthrough.py window-inspection",
      "module_ids": [
        "lightbench",
        "bench-controls",
        "station",
        "register",
        "gauge",
        "readout"
      ]
    },
    {
      "id": "strip-projection",
      "name": "投影扫描条带并定位光学样本",
      "entry": "GET /lightbench/{reel}/strip",
      "steps": [
        "定位选中画格的扫描原页",
        "沿画格行压缩灰阶并绘制为横向图片",
        "将浏览器击中的画格行交给声槽探针"
      ],
      "success": "画面缩略投影与画格行坐标一致，缺页仍可查声音来源",
      "failure": "非法画格与扫描缺失分别返回 400 和 404",
      "verification": "python3 examples/walkthrough.py strip-projection",
      "module_ids": [
        "lightbench",
        "bench-controls",
        "bench-page",
        "capture",
        "register",
        "station"
      ]
    }
  ],
  "complexity": {
    "mechanisms": [
      "time_semantics",
      "policy_rules",
      "capacity",
      "concurrency",
      "resource_lifecycle",
      "export_freeze",
      "lineage",
      "snapshot_consistency",
      "idempotency",
      "error_propagation",
      "recovery_rollback"
    ]
  }
}
